# Google OAuth 2.0 Client ID(Web application)。留空 = 純示範模式建置。
# 本機開發:複製本檔為 .env.local 後填入;正式建置由 CI 從 GitHub secret GMAIL_CLIENT_ID 寫入 .env.production
VITE_GMAIL_CLIENT_ID=

# (選用)YouTube 上傳專用用戶端 ID;留空 = 沿用上面的 VITE_GMAIL_CLIENT_ID(同一個 Cloud 專案,
# 需啟用 YouTube Data API v3)。設定與注意事項見 docs/SETUP.md §11
VITE_YOUTUBE_CLIENT_ID=

# (選用)雲端列 Drive 專用 Client ID;留空 = 沿用上面的 VITE_GMAIL_CLIENT_ID。GIS token model
# 不需 Redirect URI,但該 Cloud 專案須啟用 Google Drive API、Authorized JavaScript origins 加入
# 正式站與 http://localhost:5173(僅 scheme+host,勿帶 /TEXT-Message/ 路徑),且同意畫面 Testing
# 狀態需把自己加入 Test users(drive.readonly 為敏感範圍)。規劃見 docs/DRIVE-PLAN.md
VITE_DRIVE_CLIENT_ID=
