# Google OAuth 2.0 Client ID(Web application)。留空 = 純示範模式建置。
# 本機開發:複製本檔為 .env.local 後填入;正式建置由 CI 從 GitHub secret GMAIL_CLIENT_ID 寫入 .env.production
VITE_GMAIL_CLIENT_ID=

# (選用)YouTube 上傳專用用戶端 ID;留空 = 沿用上面的 VITE_GMAIL_CLIENT_ID(同一個 Cloud 專案,
# 需啟用 YouTube Data API v3)。設定與注意事項見 docs/SETUP.md §11
VITE_YOUTUBE_CLIENT_ID=
